VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Server-only secrets for CBE payment verification, receipt OCR and trusted
# wallet finalization. Never prefix these with VITE_ and never expose them to
# the browser.
